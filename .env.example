# Copy to .env to activate Supabase-backed services.
# Leaving these unset keeps the app on in-memory local services.
#
# Target schema (create in Supabase SQL editor when you activate):
#   users             (id uuid pk, email text, created_at timestamptz)
#   characters        (id uuid pk, user_id uuid fk, name text, class text,
#                      level int, xp int, zone_id text, position jsonb,
#                      health int, mana int, updated_at timestamptz)
#   inventory_items   (id uuid pk, character_id uuid fk, slot int,
#                      item_key text, qty int)
#   chat_messages     (id uuid pk, channel text, user_id uuid, body text,
#                      created_at timestamptz)
#   zone_players      (zone_id text, user_id uuid, character_id uuid,
#                      position jsonb, updated_at timestamptz,
#                      primary key(zone_id, user_id))
#
# Realtime channels:
#   chat:global, chat:zone:<id>, zone:<id>
#
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pipeline path for Phase 2 (not used by runtime)
WAR_CLIENT_DIR=
