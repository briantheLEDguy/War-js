# Client: set VITE_ORVR_SERVER_URL to expose the shared campaign entry.
VITE_ORVR_SERVER_URL=ws://127.0.0.1:8788/orvr
VITE_ORVR_SUPABASE_URL=
VITE_ORVR_SUPABASE_PUBLISHABLE_KEY=
# Server development uses --dev-auth, binds only to loopback, and stores state locally.
ORVR_HOST=127.0.0.1
ORVR_PORT=8788
ORVR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORVR_CAMPAIGN_ID=world-orvr-v1
ORVR_CHECKPOINT=artifacts/orvr/campaign.json
# Supabase server mode (never prefix the secret with VITE_).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
