{
  "name": "war-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Native Unreal AegisWar project with shared content, asset tooling and retained campaign/persistence infrastructure.",
  "scripts": {
    "build": "npm run unreal:build -- --target Editor",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:size": "node scripts/audit-repository-size.mjs",
    "builder:generate": "node scripts/generate-builder-catalog.mjs",
    "builder:validate": "node scripts/generate-builder-catalog.mjs --check",
    "campaign:generate": "node scripts/campaign/generate-static-campaign.mjs",
    "world:validate": "node scripts/validate-world-edits.mjs",
    "models:list": "node scripts/blender-character-pipeline/tools/list-blueprints.mjs",
    "models:validate": "node scripts/blender-character-pipeline/tools/validate-blueprints.mjs",
    "models:validate:strict": "node scripts/blender-character-pipeline/tools/validate-blueprints.mjs --strict",
    "models:validate:character": "node scripts/blender-character-pipeline/pipeline-tools/validate-test-assets.mjs",
    "models:doctor": "node scripts/blender-character-pipeline/tools/model-doctor.mjs",
    "models:generate:test-assets": "node scripts/blender-character-pipeline/pipeline-tools/generate-test-assets.mjs all",
    "models:assemble-battle-prelate": "node scripts/blender-character-pipeline/tools/assemble-runtime-equipped-review.mjs",
    "models:audit-clearance": "node scripts/blender-character-pipeline/tools/audit-equipped-clearance.mjs",
    "models:registry": "node scripts/blender-character-pipeline/tools/compile-runtime-registry.mjs",
    "models:promote-roster": "node scripts/blender-character-pipeline/tools/promote-roster-revision.mjs",
    "models:sync-playables": "node scripts/blender-character-pipeline/tools/retired-proxy-sync.mjs playable-character",
    "models:sync-npcs": "node scripts/blender-character-pipeline/tools/retired-proxy-sync.mjs NPC-character",
    "models:cleanup-proxies": "node scripts/blender-character-pipeline/tools/cleanup-proxy-assets.mjs --apply",
    "models:cleanup-proxies:check": "node scripts/blender-character-pipeline/tools/cleanup-proxy-assets.mjs --check",
    "models:cleanup-roster": "node scripts/blender-character-pipeline/tools/cleanup-full-roster-history.mjs",
    "models:import-external": "node scripts/blender-character-pipeline/tools/import-external-assets.mjs",
    "models:generate": "node scripts/blender-character-pipeline/tools/generate-asset.mjs",
    "models:roster": "node scripts/blender-character-pipeline/tools/generate-roster.mjs",
    "models:all": "node scripts/blender-character-pipeline/tools/generate-all.mjs",
    "server:dev": "tsx --env-file-if-exists=.env.orvr server/start.ts --dev-auth",
    "server:start": "tsx --env-file-if-exists=.env.orvr server/start.ts",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "test:orvr": "vitest run orvr expandedOrvrZones",
    "unreal:doctor": "tsx scripts/unreal/toolchain.ts",
    "unreal:world-plan": "tsx scripts/unreal/world-portals.ts",
    "unreal:zone-network-proof": "tsx scripts/unreal/zone-network-proof.ts",
    "unreal:export": "tsx scripts/unreal/export-content.ts",
    "unreal:assets": "tsx scripts/unreal/asset-ledger.ts --output artifacts/unreal/asset-ledger.json",
    "unreal:audit": "tsx scripts/unreal/migration.ts",
    "unreal:stage": "tsx scripts/unreal/migration.ts --stage-development",
    "unreal:release-check": "tsx scripts/unreal/migration.ts --strict",
    "unreal:build": "tsx scripts/unreal/build.ts",
    "unreal:test-native": "tsx scripts/unreal/editor.ts --mode test",
    "unreal:import": "tsx scripts/unreal/editor.ts --mode import",
    "unreal:network-proof": "tsx scripts/unreal/network-proof.ts",
    "unreal:inventory-fixtures": "tsx scripts/unreal/verify-browser-fixtures.ts inventory",
    "unreal:quest-fixtures": "tsx scripts/unreal/verify-browser-fixtures.ts quests",
    "unreal:progression-fixtures": "tsx scripts/unreal/verify-browser-fixtures.ts progression",
    "unreal:salvage-fixtures": "tsx scripts/unreal/verify-browser-fixtures.ts salvage",
    "unreal:package-proof": "tsx scripts/unreal/package-proof.ts",
    "typecheck:unreal-tools": "tsc --project tsconfig.unreal-tools.json --noEmit",
    "test:unreal": "vitest run unreal --maxWorkers=2",
    "unreal:capital-proof": "tsx scripts/unreal/capital-proof.ts",
    "unreal:population-proof": "tsx scripts/unreal/city-population-proof.ts",
    "unreal:crownward-proof": "tsx scripts/unreal/crownward-proof.ts",
    "unreal:content-inventory": "tsx scripts/unreal/native-content.ts inventory",
    "unreal:content-check": "tsx scripts/unreal/native-content.ts check",
    "unreal:content-sync": "tsx scripts/unreal/native-content.ts sync",
    "unreal:collaboration-audit": "powershell -NoProfile -File scripts/unreal/collaboration-audit.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "three": "^0.167.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.5.0",
    "@types/three": "^0.167.0",
    "@types/ws": "8.18.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.8"
  }
}
