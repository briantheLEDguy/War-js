{
  "name": "war-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based fantasy MMO/RPG vertical slice with a static Aegis vs Riftbound campaign. Built with Three.js + React + Vite, with Supabase-ready service interfaces.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "campaign:generate": "node scripts/campaign/generate-static-campaign.mjs",
    "world:validate": "node scripts/validate-world-edits.mjs",
    "models:list": "node scripts/blender-character-pipeline/tools/list-blueprints.mjs",
    "models:validate": "node scripts/blender-character-pipeline/tools/validate-blueprints.mjs",
    "models:sync-playables": "node scripts/blender-character-pipeline/tools/sync-playable-assets.mjs",
    "models:sync-npcs": "node scripts/blender-character-pipeline/tools/sync-npc-assets.mjs",
    "models:import-external": "node scripts/blender-character-pipeline/tools/import-external-assets.mjs",
    "models:generate": "node scripts/blender-character-pipeline/tools/generate-asset.mjs",
    "models:all": "node scripts/blender-character-pipeline/tools/generate-all.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.8"
  }
}
