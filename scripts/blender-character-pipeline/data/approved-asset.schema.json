{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-js.local/schemas/approved-asset.schema.json",
  "title": "War-js Approved Runtime Asset",
  "type": "object",
  "required": ["schemaVersion", "assetId", "category", "model", "runtime", "compatibility", "hashes", "review", "approvalState"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": { "type": "string" },
    "displayName": { "type": "string" },
    "category": { "enum": ["character", "body", "armor", "weapon", "jewel", "prop", "terrain"] },
    "model": { "type": "string", "pattern": "^[a-z0-9_.-]+\\.glb$" },
    "qc": { "type": "string", "pattern": "^[a-z0-9_.-]+\\.qc\\.json$" },
    "runtime": { "type": "object" },
    "compatibility": {
      "type": "object",
      "required": ["bodyFamily", "bodyVariant", "skeletonId", "bindPoseId"],
      "properties": {
        "bodyFamily": { "type": "string" },
        "bodyVariant": { "enum": ["m", "f", "neutral"] },
        "skeletonId": { "type": "string" },
        "bindPoseId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "required": ["modelSha256", "qcSha256", "previews"],
      "properties": {
        "modelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "qcSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previews": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "additionalProperties": false
    },
    "previews": { "type": "object", "additionalProperties": { "type": "string" } },
    "review": {
      "type": "object",
      "required": ["reviewedBy", "reviewedAt", "reviewHash"],
      "properties": {
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": true
    },
    "provenance": { "type": "object" },
    "approvalState": { "const": "approved" }
  },
  "additionalProperties": false
}
