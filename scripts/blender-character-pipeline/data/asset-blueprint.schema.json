{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://war-js.local/schemas/asset-blueprint.schema.json",
  "title": "War-js Manifest-First Asset Blueprint",
  "type": "object",
  "required": [
    "assetId",
    "displayName",
    "category",
    "version",
    "output",
    "geometry",
    "materials",
    "provenance",
    "qc"
  ],
  "properties": {
    "assetId": {
      "type": "string",
      "pattern": "^(chr|body|arm|wep|jwl|prop|terrain)\\.[a-z0-9_.-]+$"
    },
    "displayName": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["character", "body", "armor", "weapon", "jewel", "prop", "terrain"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sets": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "runtime": {
      "type": "object",
      "properties": {
        "profileKey": { "type": "string" },
        "itemKey": { "type": "string" },
        "staticKey": { "type": "string" },
        "bodyModel": { "type": "string" },
        "bodyFamily": { "type": "string" },
        "bodyVariant": { "type": "string", "enum": ["m", "f"] },
        "skeletonId": { "type": "string" },
        "bindPoseId": { "type": "string" },
        "logicalSlot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z0-9_.-]+\\.glb$" },
        "artifactDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["characterPreset", "staticPreset", "armorModule", "bodyModule", "weaponModule", "jewelModule", "copyExisting", "externalImport", "mpfbBody", "localModularSet"]
        },
        "preset": { "type": "string" },
        "objectNamePrefixes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "copyFrom": { "type": "string" },
        "source": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["glb", "gltf", "fbx", "obj", "blend"] },
        "objects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recipe": { "type": "string" },
        "slotMap": { "type": "string" }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["originRule", "upAxis", "forwardAxis", "lods"],
      "properties": {
        "originRule": { "type": "string" },
        "upAxis": { "type": "string", "enum": ["+Y"] },
        "forwardAxis": { "type": "string", "enum": ["+Z"] },
        "bodyFamily": { "type": "string" },
        "bodyVariant": { "type": "string", "enum": ["m", "f"] },
        "skeletonId": { "type": "string" },
        "bindPoseId": { "type": "string" },
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "triTarget"],
            "properties": {
              "name": { "type": "string" },
              "triTarget": { "type": "integer", "minimum": 1 },
              "screenCoverageMin": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "parent"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "parent": { "type": "string" },
          "position": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "materials": {
      "type": "object",
      "required": ["master", "channels"],
      "properties": {
        "master": { "type": "string" },
        "textureSet": { "type": "string" },
        "maxTextureResolution": { "type": "integer", "minimum": 64, "maximum": 2048 },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["baseColor", "roughness", "metallic", "normal", "occlusion", "emissive", "opacity"]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "rigging": {
      "type": "object",
      "properties": {
        "skinned": { "type": "boolean" },
        "maxInfluences": { "type": "integer", "minimum": 1 },
        "requiredClips": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "collision": {
      "type": "object",
      "required": ["policy"],
      "properties": {
        "policy": { "type": "string" },
        "primitives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "tag"],
            "properties": {
              "type": { "type": "string" },
              "tag": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "occupiesSlots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflictsWith": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["createdBy", "aiAssisted", "aiStages", "referencePackId", "similarityReview"],
      "properties": {
        "createdBy": { "type": "string" },
        "aiAssisted": { "type": "boolean" },
        "aiStages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "promptIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "referencePackId": { "type": "string" },
        "author": { "type": "string" },
        "source": { "type": "string" },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "taskId": { "type": "string" },
            "modelVersion": { "type": "string" },
            "seed": { "type": ["integer", "string"] },
            "promptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "referenceSha256": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "required": ["name", "sourceUrl"],
          "properties": {
            "name": { "type": "string" },
            "sourceUrl": { "type": "string" },
            "termsUrl": { "type": "string" }
          },
          "additionalProperties": false
        },
        "similarityReview": {
          "type": "string",
          "enum": ["not_required", "pending", "passed", "failed"]
        }
      },
      "additionalProperties": false
    },
    "qc": {
      "type": "object",
      "required": ["allowNonManifold", "allowUvOverlap", "maxDrawCalls", "maxFileSizeMb"],
      "properties": {
        "allowNonManifold": { "type": "boolean" },
        "allowUvOverlap": { "type": "boolean" },
        "maxDrawCalls": { "type": "integer", "minimum": 1 },
        "maxFileSizeMb": { "type": "number", "minimum": 0.1 },
        "groundToleranceM": { "type": "number", "minimum": 0 },
        "expectedHeightM": { "type": "number", "minimum": 0 },
        "heightToleranceM": { "type": "number", "minimum": 0 },
        "maxMeshObjects": { "type": "integer", "minimum": 1 },
        "requiresSkinnedMeshes": { "type": "boolean" },
        "requiresPreview": { "type": "boolean" },
        "maxTris": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "qc_passed", "review_pending", "approved", "rejected", "blocked", "promoted"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
